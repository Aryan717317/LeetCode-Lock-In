{
  "manifest_version": 3,
  "name": "LeetCode Lock-In",
  "version": "1.0.0",
  "description": "Block distracting websites until you solve LeetCode problems. Stay disciplined, stay sharp.",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://leetcode.com/problems/*",
        "*://www.leetcode.com/problems/*"
      ],
      "js": [
        "leetcode-detector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://leetcode.com/*",
        "*://www.leetcode.com/*"
      ],
      "js": [
        "leetcode-api.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lock.html",
        "lock.css",
        "lock.js",
        "problems/neetcode150.json",
        "problems/striver.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}